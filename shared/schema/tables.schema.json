        },
        "deleted": {
          "type": "integer",
          "enum": [0, 1]
        },
        "project_id": {
          "type": ["string", "null"]
        },
        "title": {
          "type": "string"
        },
        "body_md": {
          "type": "string"
        },
        "tags": {
          "type": "string",
          "x-encoding": "json-string-array"
        },
        "favorite": {
          "type": "integer",
          "enum": [0, 1]
        },
        "use_count": {
          "type": "integer"
        },
        "last_used_at": {
          "type": ["integer", "null"]
