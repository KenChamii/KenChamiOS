{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tables.schema.json",
  "title": "KenChamiOS table rows",
  "description": "One row per table as stored by the desktop migrations. Sync columns: id, created_at, updated_at, device_id, deleted.",
  "$defs": {
    "activity": {
      "type": "object",
      "x-synced": true,
      "x-android": true,
      "properties": {
        "id": {
          "type": "string"
        },
        "created_at": {
          "type": "integer"
        },
        "updated_at": {
          "type": "integer"
        },
        "device_id": {
          "type": "string"
        },
        "deleted": {
          "type": "integer",
          "enum": [0, 1]
        },
        "kind": {
          "type": "string"
        },
        "entity_type": {
          "type": "string"
        },
        "entity_id": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "at": {
          "type": "integer"
        }
      },
      "required": ["id", "created_at", "updated_at", "device_id", "deleted", "kind", "entity_type", "entity_id", "summary", "at"],
      "additionalProperties": false
    },
    "change_log": {
      "type": "object",
      "x-synced": false,
      "x-not-synced-reason": "sync bookkeeping, one entry per changed row on this device",
      "x-android": true,
      "properties": {
        "seq": {
          "type": "integer"
        },
        "table_name": {
          "type": "string"
        },
        "row_id": {
          "type": "string"
        },
        "hlc": {
          "type": "integer"
        }
      },
      "required": ["seq", "table_name", "row_id", "hlc"],
      "additionalProperties": false
    },
    "paired_devices": {
      "type": "object",
      "x-synced": false,
      "x-not-synced-reason": "desktop only: the phones allowed to sync, with the hash of their token",
      "x-android": false,
      "properties": {
        "device_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "token_hash": {
          "type": "string"
        },
        "paired_at": {
          "type": "integer"
        },
        "last_sync_at": {
          "type": ["integer", "null"]
        },
        "pulled_seq": {
          "type": "integer"
        }
      },
      "required": ["device_id", "name", "token_hash", "paired_at", "pulled_seq"],
      "additionalProperties": false
    },
    "checklist_items": {
      "type": "object",
      "x-synced": true,
      "x-android": true,
      "properties": {
        "id": {
          "type": "string"
        },
        "created_at": {
          "type": "integer"
        },
        "updated_at": {
          "type": "integer"
        },
        "device_id": {
          "type": "string"
        },
        "deleted": {
          "type": "integer",
          "enum": [0, 1]
        },
        "task_id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "done": {
          "type": "integer",
          "enum": [0, 1]
        },
        "order_key": {
          "type": "string"
        }
      },
      "required": ["id", "created_at", "updated_at", "device_id", "deleted", "task_id", "text", "done", "order_key"],
      "additionalProperties": false
    },
    "export_templates": {
      "type": "object",
      "x-synced": false,
      "x-not-synced-reason": "desktop-only workflow data, the phone does not create this table",
      "x-android": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "created_at": {
          "type": "integer"
        },
        "updated_at": {
          "type": "integer"
        },
        "device_id": {
          "type": "string"
        },
        "deleted": {
          "type": "integer",
          "enum": [0, 1]
        },
        "kind": {
          "$ref": "enums.schema.json#/$defs/template_kind"
        },
        "name": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "is_default": {
          "type": "integer",
          "enum": [0, 1]
        }
      },
      "required": ["id", "created_at", "updated_at", "device_id", "deleted", "kind", "name", "body", "is_default"],
      "additionalProperties": false
    },
    "habits": {
      "type": "object",
      "x-synced": true,
      "x-android": true,
      "properties": {
        "id": {
          "type": "string"
        },
