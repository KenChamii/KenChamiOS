          "type": "string"
        }
      },
      "required": ["id", "created_at", "updated_at", "device_id", "deleted", "name"],
      "additionalProperties": false
    },
    "habit_checks": {
      "type": "object",
      "x-synced": true,
      "x-android": true,
      "x-unique-live": ["habit_id", "day"],
      "properties": {
        "id": {
          "type": "string"
        },
        "created_at": {
          "type": "integer"
        },
        "updated_at": {
          "type": "integer"
        },
        "device_id": {
          "type": "string"
        },
        "deleted": {
          "type": "integer",
          "enum": [0, 1]
        },
        "habit_id": {
          "type": "string"
        },
        "day": {
          "type": "string",
          "format": "date",
          "description": "local calendar day, YYYY-MM-DD"
        }
      },
      "required": ["id", "created_at", "updated_at", "device_id", "deleted", "habit_id", "day"],
      "additionalProperties": false
    },
    "daily_notes": {
      "type": "object",
      "x-synced": true,
      "x-android": true,
      "x-unique-live": ["day"],
      "properties": {
        "id": {
          "type": "string"
        },
        "created_at": {
          "type": "integer"
        },
        "updated_at": {
          "type": "integer"
        },
        "device_id": {
          "type": "string"
        },
        "deleted": {
          "type": "integer",
          "enum": [0, 1]
        },
        "day": {
          "type": "string",
          "format": "date",
          "description": "local calendar day, YYYY-MM-DD"
        },
        "body": {
          "type": "string",
          "description": "markdown"
        }
      },
      "required": ["id", "created_at", "updated_at", "device_id", "deleted", "day", "body"],
      "additionalProperties": false
    },
    "media_entries": {
      "type": "object",
      "x-synced": true,
      "x-android": true,
      "x-unique-live": ["media_item_id"],
      "properties": {
        "id": {
          "type": "string"
        },
        "created_at": {
          "type": "integer"
        },
        "updated_at": {
          "type": "integer"
        },
        "device_id": {
          "type": "string"
        },
        "deleted": {
          "type": "integer",
          "enum": [0, 1]
        },
        "media_item_id": {
          "type": "string"
        },
        "status": {
          "$ref": "enums.schema.json#/$defs/media_status"
        },
        "progress": {
          "type": "integer",
          "minimum": 0
        },
        "progress_total": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "rating": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 10
        },
        "notes": {
          "type": "string"
        },
        "tags": {
          "type": "string",
          "x-encoding": "json-string-array"
        },
        "started_at": {
          "type": ["integer", "null"]
        },
        "finished_at": {
          "type": ["integer", "null"]
        },
        "platform": {
          "type": ["string", "null"]
        }
      },
      "required": ["id", "created_at", "updated_at", "device_id", "deleted", "media_item_id", "status", "progress", "notes", "tags"],
      "additionalProperties": false
    },
    "media_items": {
      "type": "object",
      "x-synced": true,
      "x-android": true,
      "x-local-columns": ["cover_cache_path"],
      "x-unique-live": ["source", "external_id"],
      "properties": {
        "id": {
          "type": "string"
        },
        "created_at": {
          "type": "integer"
        },
        "updated_at": {
          "type": "integer"
        },
        "device_id": {
          "type": "string"
        },
        "deleted": {
          "type": "integer",
          "enum": [0, 1]
        },
        "type": {
          "$ref": "enums.schema.json#/$defs/media_type"
        },
        "title": {
          "type": "string"
        },
        "cover_url": {
          "type": ["string", "null"]
        },
        "cover_cache_path": {
          "type": ["string", "null"]
        },
        "year": {
          "type": ["integer", "null"]
        },
        "genres": {
          "type": "string",
          "x-encoding": "json-string-array"
        },
        "synopsis": {
          "type": "string"
        },
        "source": {
          "$ref": "enums.schema.json#/$defs/media_source"
        },
        "external_id": {
          "type": ["string", "null"]
        }
      },
      "required": ["id", "created_at", "updated_at", "device_id", "deleted", "type", "title", "genres", "synopsis", "source"],
      "additionalProperties": false
    },
    "media_progress_log": {
      "type": "object",
      "x-synced": true,
      "x-android": true,
      "properties": {
        "id": {
          "type": "string"
        },
        "created_at": {
          "type": "integer"
        },
        "updated_at": {
          "type": "integer"
        },
        "device_id": {
          "type": "string"
        },
        "deleted": {
          "type": "integer",
          "enum": [0, 1]
        },
        "entry_id": {
          "type": "string"
        },
        "delta": {
          "type": "integer"
        },
        "value_after": {
          "type": "integer"
        },
        "logged_at": {
          "type": "integer"
        }
      },
      "required": ["id", "created_at", "updated_at", "device_id", "deleted", "entry_id", "delta", "value_after", "logged_at"],
      "additionalProperties": false
    },
    "metadata_cache": {
      "type": "object",
      "x-synced": false,
      "x-not-synced-reason": "provider answers cached on this device",
      "x-android": false,
      "properties": {
        "cache_key": {
          "type": "string"
        },
        "payload": {
          "type": "string"
        },
        "fetched_at": {
          "type": "integer"
        }
      },
      "required": ["cache_key", "payload", "fetched_at"],
      "additionalProperties": false
    },
    "project_assets": {
      "type": "object",
      "x-synced": false,
      "x-not-synced-reason": "desktop-only workflow data, the phone does not create this table; screenshot files stay on the desktop",
      "x-android": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "created_at": {
          "type": "integer"
        },
        "updated_at": {
          "type": "integer"
        },
        "device_id": {
          "type": "string"
        },
        "deleted": {
          "type": "integer",
          "enum": [0, 1]
        },
        "project_id": {
          "type": "string"
        },
        "kind": {
          "$ref": "enums.schema.json#/$defs/asset_kind"
        },
        "path_or_url": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "order_key": {
          "type": "string"
        }
      },
      "required": ["id", "created_at", "updated_at", "device_id", "deleted", "project_id", "kind", "path_or_url", "caption", "order_key"],
      "additionalProperties": false
    },
    "project_docs": {
      "type": "object",
      "x-synced": true,
      "x-android": true,
      "x-unique-live": ["project_id", "kind"],
