    "settings": {
      "type": "object",
      "x-synced": false,
      "x-not-synced-reason": "holds this device's id and local preferences",
      "x-android": true,
      "properties": {
        "id": {
          "type": "string"
        },
        "created_at": {
          "type": "integer"
        },
        "updated_at": {
          "type": "integer"
