    "tasks": {
      "type": "object",
      "x-synced": true,
      "x-android": true,
      "properties": {
        "id": {
          "type": "string"
        },
        "created_at": {
          "type": "integer"
        },
        "updated_at": {
          "type": "integer"
        },
        "device_id": {
          "type": "string"
        },
        "deleted": {
          "type": "integer",
          "enum": [0, 1]
        },
        "project_id": {
          "type": "string"
        },
        "parent_id": {
          "type": ["string", "null"]
        },
        "title": {
          "type": "string"
        },
        "body_md": {
          "type": "string"
        },
        "acceptance_md": {
          "type": "string"
        },
        "related_files": {
          "type": "string",
          "x-encoding": "json-string-array"
        },
        "status": {
          "$ref": "enums.schema.json#/$defs/task_status"
