          "type": "integer"
        },
        "updated_at": {
          "type": "integer"
        },
        "device_id": {
          "type": "string"
        },
        "deleted": {
          "type": "integer",
          "enum": [0, 1]
        },
        "name": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "stage": {
          "$ref": "enums.schema.json#/$defs/stage"
        },
        "description": {
          "type": "string"
        },
        "repo_path": {
          "type": ["string", "null"]
        },
