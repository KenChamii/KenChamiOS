        },
        "created_at": {
          "type": "integer"
        },
        "updated_at": {
          "type": "integer"
        },
        "device_id": {
          "type": "string"
        },
        "deleted": {
          "type": "integer",
          "enum": [0, 1]
        },
        "project_id": {
          "type": "string"
        },
        "kind": {
          "$ref": "enums.schema.json#/$defs/doc_kind"
        },
        "title": {
          "type": "string"
        },
        "body_md": {
          "type": "string"
        }
      },
      "required": ["id", "created_at", "updated_at", "device_id", "deleted", "project_id", "kind", "title", "body_md"],
      "additionalProperties": false
    },
    "projects": {
      "type": "object",
      "x-synced": true,
