          "type": ["string", "null"]
        },
        "tags": {
          "type": "string",
          "x-encoding": "json-string-array"
        },
        "archived": {
          "type": "integer",
          "enum": [0, 1]
        },
        "finished_at": {
          "type": ["integer", "null"]
        }
      },
      "required": ["id", "created_at", "updated_at", "device_id", "deleted", "name", "slug", "stage", "description", "tags", "archived"],
      "additionalProperties": false
