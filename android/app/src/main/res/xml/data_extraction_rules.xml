<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- no cloud copies of the database: all data stays on the owner's devices -->
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
</data-extraction-rules>
